{
  "name": "qaoverflow-tests",
  "version": "1.0.0",
  "description": "Regression test suite for QA Overflow blog",
  "scripts": {
    "build": "npx @11ty/eleventy",
    "build:search": "npx @11ty/eleventy && npx pagefind --source _site",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:report": "jest --verbose --json --outputFile=test-report.json"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "cheerio": "^1.0.0-rc.12",
    "jest": "^29.7.0",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "puppeteer": "^24.42.0"
  }
}
