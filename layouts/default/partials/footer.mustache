<!-- Footer -->
<footer>
    <div class="container">
        <hr/>
        <p class="text-center">Publicado por <strong><a target="_blank" href="https://github.com/qaoverflow">QA Overflow</a></strong></p>
    </div>
</footer>

<!-- Bootstrap and other Script files -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
<script src="{{settings.url}}/js/plugins/highlight/highlight.pack.js"></script>
<script src="{{settings.url}}/js/plugins/lightbox/ekko-lightbox.min.js"></script>

<script>
    var __blogURL = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
        ? 'http://localhost/QA_OverFlow/public'
        : 'https://qaoverflow.com';
</script>

<script src="{{settings.url}}/js/blog.js"></script>
<script src="{{settings.url}}/js/search.js"></script>

{{#settings.analytics}}
<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{settings.analytics}}"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{settings.analytics}}');
</script>
{{/settings.analytics}}

</body>
</html>