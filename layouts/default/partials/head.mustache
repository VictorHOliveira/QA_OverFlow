<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="QA Overflow" />
    <meta name="description" content="{{settings.tagline}}">
    <meta name="author" content="{{settings.author}}">

    <title>{{#post.title}}{{.}} :: {{/post.title}}{{#page.title}}{{.}} :: {{/page.title}}{{settings.title}}</title>

    <!-- jQuery - loaded first -->
    <script src="https://code.jquery.com/jquery-2.2.4.min.js"></script>

    <!-- rss feed url -->
    <link rel="alternate" type="application/rss+xml" title="{{settings.title}}" href="{{settings.url}}/rss.xml"/>

    <!-- favicon -->
    <link rel="shortcut icon" href="/favicon.ico"/>
    <link rel="shortcut icon" href="{{settings.url}}/favicon.ico"/>

    <!-- Bootstrap CSS file -->
    {{#isDarkTheme}}
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@3.4.1/darkly/bootstrap.min.css" rel="stylesheet"/>
    {{/isDarkTheme}}
    {{^isDarkTheme}}
    <link href="{{settings.url}}/js/plugins/bootstrap-3.0.3/css/{{settings.theme}}" rel="stylesheet"/>
    {{/isDarkTheme}}
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="{{settings.url}}/js/plugins/bootstrap-3.0.3/plugins/social-buttons.css" rel="stylesheet"/>

    <!-- syntax highlighter css file -->
    <link href="{{settings.url}}/js/plugins/highlight/styles/github.css" rel="stylesheet"/>

    <!-- lightbox for images -->
    <link href="{{settings.url}}/js/plugins/lightbox/ekko-lightbox.min.css" rel="stylesheet"/>

    <!-- blog custom CSS file -->
    <link href="{{settings.url}}/css/style.css" rel="stylesheet"/>
    {{#isDarkTheme}}
    <link href="{{settings.url}}/css/theme.css" rel="stylesheet"/>
    {{/isDarkTheme}}
</head>