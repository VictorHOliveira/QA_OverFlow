# Auto detect text files
* text=auto eol=lf

# Web files encoding
*.html text charset=utf-8
*.json text charset=utf-8
*.js text charset=utf-8
*.css text charset=utf-8
*.xml text charset=utf-8
*.md text charset=utf-8

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

# ATENCAO: Todos os arquivos devem ser mantidos em UTF-8
# Nao altere o encoding para evitar problemas com caracteres pt-BR
