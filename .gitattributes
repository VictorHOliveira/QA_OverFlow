# Auto detect text files and ensure UTF-8 encoding
* text=auto eol=lf

# Explicitly declare encoding for web files
*.html text charset=utf-8
*.json text charset=utf-8
*.js text charset=utf-8
*.css text charset=utf-8
*.xml text charset=utf-8
*.md text charset=utf-8

# Keep binary files unchanged
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
