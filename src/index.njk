---
layout: layouts/base.njk
title: Início
description: "{{ site.tagline }}"
ogType: website
---

{% set publishedPosts = posts | filter("status", "published") | sort(false, "datePublished") | reverse %}
{% set recentPosts = publishedPosts | head(5) %}

<div class="row g-5">
    <div class="col-lg-8">
        <div class="mb-5">
            <h1 class="display-5 fw-bold mb-3">
                <span class="text-primary">QA</span> Overflow
            </h1>
            <p class="lead text-muted">
                {{ site.tagline }}
            </p>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="h4 fw-bold mb-0">
                <i class="bi bi-lightning-charge text-primary me-2"></i>
                Posts Recentes
            </h2>
            <a href="/posts.html" class="btn btn-outline-primary btn-sm">
                Ver todos <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            {% for post in recentPosts %}
            <div class="col-12">
                <article class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <span class="badge bg-primary-subtle text-primary">
                                <i class="bi bi-folder me-1"></i>{{ post.category }}
                            </span>
                            <span class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>{{ post.dated }}
                            </span>
                        </div>
                        
                        <h3 class="h5 fw-bold mb-3">
                            <a href="/post/{{ post.slug }}/" class="text-decoration-none text-reset stretched-link">
                                {{ post.title }}
                            </a>
                        </h3>
                        
                        <p class="text-muted mb-0">{{ post.summary | safe | striptags | truncate(160, " ...") }}</p>
                        
                        <div class="mt-3 pt-3 border-top d-flex flex-wrap gap-2">
                            {% for tag in post.tags | head(3) %}
                            <span class="badge bg-secondary-subtle text-secondary small">
                                #{{ tag }}
                            </span>
                            {% endfor %}
                            {% if post.tags.length > 3 %}
                            <span class="badge bg-secondary-subtle text-secondary small">
                                +{{ post.tags.length - 3 }} mais
                            </span>
                            {% endif %}
                        </div>
                    </div>
                </article>
            </div>
            {% endfor %}
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sticky-top" style="top: 5rem;">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Sobre
                    </h5>
                    <p class="text-muted small mb-0">
                        Blog especializado em QA (Quality Assurance), Automação de Testes e melhores práticas. Compartilhando experiências reais de quem está na trincheira há mais de uma década.
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-tags text-primary me-2"></i>
                        Categorias
                    </h5>
                    {% set categories = publishedPosts | map("category") | unique | sort %}
                    <ul class="list-unstyled mb-0">
                        {% for category in categories %}
                        {% set categoryPosts = publishedPosts | filter("category", category) %}
                        <li class="mb-2">
                            <a href="/posts.html?category={{ category }}" class="text-decoration-none d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-folder text-secondary me-2"></i>{{ category }}</span>
                                <span class="badge bg-primary rounded-pill">{{ categoryPosts.length }}</span>
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-hash text-primary me-2"></i>
                        Tags
                    </h5>
                    {% set allTags = [] %}
                    {% for post in publishedPosts %}
                        {% for tag in post.tags %}
                            {% if allTags.indexOf(tag) === -1 %}
                                {% set allTags = allTags.concat([tag]) %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                    {% set allTags = allTags | sort %}
                    
                    <div class="d-flex flex-wrap gap-2">
                        {% for tag in allTags %}
                        <a href="/posts.html?tag={{ tag }}" class="badge bg-secondary-subtle text-secondary text-decoration-none hover-bg-primary">
                            #{{ tag }}
                        </a>
                        {% endfor %}
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>
