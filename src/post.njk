---
layout: layouts/base.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "post/{{ post.slug }}/"
eleventyComputed:
  title: "{{ post.title }}"
  description: "{{ post.description or (post.summary | striptags) }}"
  ogType: "article"
---

{% set postIndex = posts | findIndex("slug", post.slug) %}
{% set prevPost = null %}
{% set nextPost = null %}
{% if postIndex > 0 %}{% set prevPost = posts[postIndex - 1] %}{% endif %}
{% if postIndex < (posts.length - 1) %}{% set nextPost = posts[postIndex + 1] %}{% endif %}

{% set contentHtml = post.content | addAnchors %}
{% set tocItems = contentHtml | toc %}

<div class="row">
    <div class="col-lg-8">
        <article class="blog-post">
            <header class="mb-4">
                <div class="d-flex align-items-center text-muted mb-3 small">
                    <span class="badge bg-primary me-2">{{ post.category | upper }}</span>
                    <time datetime="{{ post.datePublished }}">
                        <i class="bi bi-calendar3 me-1"></i>{{ post.datePublished }}
                    </time>
                    {% if post.dateModified and post.dateModified !== post.datePublished %}
                    <span class="ms-2 text-info-emphasis small">
                        <i class="bi bi-pencil-square me-1"></i>Atualizado em {{ post.dateModified }}
                    </span>
                    {% endif %}
                </div>
                
                <h1 class="display-5 fw-bold mb-3">{{ post.title }}</h1>
                
                <div class="d-flex align-items-center mb-4">
                    <i class="bi bi-person-circle text-primary fs-1 me-3"></i>
                    <div>
                        <p class="fw-semibold mb-0">{{ post.author }}</p>
                        <small class="text-muted">
                            {% if post.readTime %}<i class="bi bi-clock me-1"></i>{{ post.readTime }}{% endif %}
                        </small>
                    </div>
                </div>
                
                {% if post.coverImage %}
                <img src="{{ post.coverImage }}" alt="{{ post.title }}" class="img-fluid rounded mb-4" loading="lazy">
                {% endif %}
            </header>

            {% if tocItems.length > 1 %}
            <div class="card border-0 bg-body-tertiary mb-4 d-lg-none">
                <div class="card-body p-3">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-list-ol text-primary me-1"></i>Neste artigo
                    </h6>
                    <ul class="list-unstyled mb-0 small">
                        {% for item in tocItems %}
                        <li class="{% if item.level === 3 %}ps-3{% endif %}">
                            <a href="#{{ item.id }}" class="text-decoration-none">{{ item.text }}</a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            {% endif %}
            
            <div class="post-content mb-5">
                {{ contentHtml | safe }}
            </div>
            
            <footer class="border-top pt-4">
                <div class="d-flex flex-wrap gap-2 mb-4">
                    {% for tag in post.tags %}
                    <a href="/?tag={{ tag | urlEncode }}" class="badge bg-secondary text-decoration-none">
                        <i class="bi bi-tag me-1"></i>{{ tag }}
                    </a>
                    {% endfor %}
                </div>
                
                <div class="share-links mb-4">
                    <span class="text-muted me-3">Compartilhar:</span>
                    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ (site.url ~ '/post/' ~ post.slug ~ '/') | urlEncode }}" class="btn btn-outline-primary btn-sm me-2" target="_blank">
                        <i class="bi bi-linkedin"></i>
                    </a>
                    <a href="https://twitter.com/intent/tweet?url={{ (site.url ~ '/post/' ~ post.slug ~ '/') | urlEncode }}&text={{ post.title | urlEncode }}" class="btn btn-outline-primary btn-sm me-2" target="_blank">
                        <i class="bi bi-twitter-x"></i>
                    </a>
                    <a href="https://api.whatsapp.com/send?text={{ (post.title ~ ' - ' ~ site.url ~ '/post/' ~ post.slug ~ '/') | urlEncode }}" class="btn btn-outline-success btn-sm" target="_blank">
                        <i class="bi bi-whatsapp"></i>
                    </a>
                </div>
            </footer>
        </article>
        
        {% if prevPost or nextPost %}
        <nav class="border-top border-bottom py-4 my-5" aria-label="Navegação de posts">
            <div class="row">
                <div class="col-md-6">
                    {% if prevPost %}
                    <a href="/post/{{ prevPost.slug }}/" class="text-decoration-none">
                        <div class="d-flex align-items-center text-muted mb-2 small">
                            <i class="bi bi-arrow-left me-1"></i> Post anterior
                        </div>
                        <h6 class="fw-semibold">{{ prevPost.title }}</h6>
                    </a>
                    {% endif %}
                </div>
                <div class="col-md-6 text-md-end">
                    {% if nextPost %}
                    <a href="/post/{{ nextPost.slug }}/" class="text-decoration-none">
                        <div class="d-flex align-items-center justify-content-md-end text-muted mb-2 small">
                            Próximo post <i class="bi bi-arrow-right ms-1"></i>
                        </div>
                        <h6 class="fw-semibold">{{ nextPost.title }}</h6>
                    </a>
                    {% endif %}
                </div>
            </div>
        </nav>
        {% endif %}

        {% set related = post | relatedPosts(posts, 3) %}
        {% if related.length %}
        <section class="my-5">
            <h5 class="fw-bold mb-4">
                <i class="bi bi-diagram-3 text-primary me-2"></i>Posts Relacionados
            </h5>
            <div class="row g-4">
                {% for rp in related %}
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <span class="badge bg-primary-subtle text-primary-emphasis mb-2">{{ rp.category }}</span>
                            <h6 class="card-title">
                                <a href="/post/{{ rp.slug }}/" class="text-decoration-none stretched-link">
                                    {{ rp.title }}
                                </a>
                            </h6>
                            <small class="text-muted">{{ rp.datePublished }}</small>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        {% if site.giscus.repoId %}
        <section class="my-5 pt-3 border-top" id="comments-section">
            <h5 class="fw-bold mb-4">
                <i class="bi bi-chat-dots text-primary me-2"></i>Comentários
                <span class="badge bg-secondary comment-count-badge ms-2" id="comment-count">0</span>
            </h5>
            <div class="giscus"></div>
            <script
              src="https://giscus.app/client.js"
              data-repo="{{ site.giscus.repo }}"
              data-repo-id="{{ site.giscus.repoId }}"
              data-category="{{ site.giscus.category }}"
              data-category-id="{{ site.giscus.categoryId }}"
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="top"
              data-theme="dark"
              data-lang="pt"
              crossorigin="anonymous"
              async>
            </script>
        </section>
        {% endif %}
    </div>
    
    <div class="col-lg-4">
        <aside class="sticky-top" style="top: 5rem;">
            {% if tocItems.length > 1 %}
            <div class="card mb-4 d-none d-lg-block">
                <div class="card-header bg-transparent border-0">
                    <h6 class="card-title mb-0">
                        <i class="bi bi-list-ol text-primary me-2"></i>Neste artigo
                    </h6>
                </div>
                <div class="card-body py-2">
                    <nav class="toc-container">
                        {% for item in tocItems %}
                        <a href="#{{ item.id }}" class="nav-link d-block {% if item.level === 3 %}toc-h3{% endif %}">
                            {{ item.text }}
                        </a>
                        {% endfor %}
                    </nav>
                </div>
            </div>
            {% endif %}

            <div class="card mb-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-person-badge text-primary me-2"></i>Sobre o Autor
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-person-circle text-primary fs-1 me-3"></i>
                        <div>
                            <h6 class="fw-semibold mb-0">{{ site.author }}</h6>
                            <small class="text-muted">QA Senior</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Com mais de 13 anos de experiência em Qualidade de Software e Automação de Testes.</p>
                    <a href="https://github.com/VictorHOliveira" class="btn btn-outline-primary btn-sm w-100" target="_blank">
                        <i class="bi bi-github me-1"></i> Ver Perfil
                    </a>
                </div>
             </div>
         </aside>
    </div>
</div>

<script>
(function() {
    var pathname = window.location.pathname;
    var countEl = document.getElementById('comment-count');

    var giscusObserver = new MutationObserver(function() {
        var giscusFrame = document.querySelector('giscus-widget');
        if (giscusFrame && giscusFrame.shadowRoot) {
            var countText = giscusFrame.shadowRoot.querySelector('.giscus-comment-count');
            if (countText && countText.textContent) {
                var match = countText.textContent.match(/\d+/);
                if (match) {
                    countEl.textContent = match[0];
                }
                giscusObserver.disconnect();
            }
        }
    });

    var giscusEl = document.querySelector('giscus-widget');
    if (giscusEl) {
        giscusObserver.observe(giscusEl, { childList: true, subtree: true, attributes: true });
    }

    document.querySelectorAll('.post-content pre').forEach(function(pre) {
        var wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        var btn = document.createElement('button');
        btn.className = 'copy-button';
        btn.textContent = 'Copiar';
        btn.setAttribute('type', 'button');
        wrapper.appendChild(btn);

        btn.addEventListener('click', function() {
            var code = pre.querySelector('code');
            var text = code ? code.textContent : pre.textContent;
            navigator.clipboard.writeText(text).then(function() {
                btn.textContent = 'Copiado!';
                btn.classList.add('copied');
                setTimeout(function() {
                    btn.textContent = 'Copiar';
                    btn.classList.remove('copied');
                }, 2000);
            });
        });
    });

    document.querySelectorAll('.post-content img').forEach(function(img) {
        if (!img.hasAttribute('loading')) {
            img.setAttribute('loading', 'lazy');
        }
    });
})();
</script>
