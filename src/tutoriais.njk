---
layout: layouts/base.njk
title: Tutoriais
description: Tutoriais práticos de QA, Automação de Testes e Robot Framework. Aprenda passo a passo com exemplos reais.
ogType: website
---

{% set publishedPosts = posts | published | sort(false, "datePublished") | reverse %}
{% set tutorialPosts = publishedPosts | filter("category", "tutoriais") %}

{% set allTags = [] %}
{% for p in tutorialPosts %}
    {% for t in p.tags %}
        {% if allTags.indexOf(t) === -1 %}
            {% set allTags = allTags.concat([t]) %}
        {% endif %}
    {% endfor %}
{% endfor %}
{% set allTags = allTags | sort %}

<div class="row g-5">
    <div class="col-lg-8">
        <div class="mb-5">
            <h1 class="display-5 fw-bold mb-3">
                <i class="bi bi-book text-primary me-2"></i>Tutoriais
            </h1>
            <p class="lead text-muted">
                Tutoriais práticos passo a passo sobre automação de testes e ferramentas.
            </p>
        </div>

        <div class="mb-4 p-4 bg-body-tertiary rounded">
            <form action="/tutoriais/" method="get" class="row g-3">
                <div class="col-md-8">
                    <label class="form-label small fw-semibold">Buscar tutoriais</label>
                    <div class="input-group">
                        <input type="text" class="form-control" name="q" placeholder="Pesquisar tutoriais..." id="searchInput">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Tag</label>
                    <select class="form-select" name="tag" id="tagFilter">
                        <option value="">Todas</option>
                        {% for tag in allTags %}
                        <option value="{{ tag }}">{{ tag }}</option>
                        {% endfor %}
                    </select>
                </div>
            </form>
        </div>

        <div id="postsContainer">
            <div class="row g-4">
                {% for post in tutorialPosts %}
                <div class="col-12" data-post-title="{{ post.title | lower }}" data-post-tags="{{ post.tags | join(' ') }}" data-post-summary="{{ (post.summary | safe | striptags | truncate(300)) | lower }}">
                    <article class="card border-0 shadow-sm hover-shadow transition-all">
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                <span class="badge bg-success-subtle text-success">
                                    <i class="bi bi-book me-1"></i> Tutorial
                                </span>
                                <span class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i>{{ post.dated }}
                                </span>
                                {% if post.readTime %}
                                <span class="text-muted small">
                                    <i class="bi bi-clock me-1"></i>{{ post.readTime }}
                                </span>
                                {% endif %}
                            </div>
                            
                            <h2 class="h4 fw-bold mb-3">
                                <a href="/post/{{ post.slug }}/" class="text-decoration-none text-reset stretched-link">
                                    {{ post.title }}
                                </a>
                            </h2>
                            
                            <p class="text-muted mb-3">
                                {{ post.summary | safe | striptags | truncate(200, " ...") }}
                            </p>
                            
                            <div class="d-flex flex-wrap gap-2">
                                {% for tag in post.tags | head(5) %}
                                <a href="/tutoriais/?tag={{ tag }}" class="badge bg-secondary-subtle text-secondary text-decoration-none">
                                    #{{ tag }}
                                </a>
                                {% endfor %}
                            </div>
                        </div>
                    </article>
                </div>
                {% else %}
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-5 text-center">
                            <i class="bi bi-book fs-1 text-muted mb-3 d-block"></i>
                            <h4 class="fw-bold mb-2">Nenhum tutorial encontrado</h4>
                            <p class="text-muted mb-0">Novos tutoriais estão sendo preparados. Volte em breve!</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sticky-top" style="top: 5rem;">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-book text-primary me-2"></i>
                        Tutoriais
                    </h5>
                    <p class="text-muted small mb-0">
                        Aprenda na prática com tutoriais passo a passo sobre ferramentas e frameworks de automação de testes.
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-stats text-primary me-2"></i>
                        Estatísticas
                    </h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-file-text text-secondary me-2"></i>
                            <strong>{{ tutorialPosts.length }}</strong> tutoriais publicados
                        </li>
                        <li class="mb-0">
                            <i class="bi bi-tags text-secondary me-2"></i>
                            <strong>{{ allTags.length }}</strong> tags
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-tags text-primary me-2"></i>
                        Tags
                    </h5>
                    <div class="d-flex flex-wrap gap-2">
                        {% for tag in allTags %}
                        {% set count = tutorialPosts | filter("tags", tag) | length %}
                        <a href="/tutoriais/?tag={{ tag }}" class="badge bg-secondary-subtle text-secondary text-decoration-none">
                            #{{ tag }} <span class="opacity-75">({{ count }})</span>
                        </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const tagFilter = document.getElementById('tagFilter');
    const postCards = document.querySelectorAll('[data-post-title]');
    
    function parseQueryParams() {
        const params = new URLSearchParams(window.location.search);
        return {
            q: params.get('q') || '',
            tag: params.get('tag') || ''
        };
    }
    
    const params = parseQueryParams();
    if (params.q) searchInput.value = params.q;
    if (params.tag) tagFilter.value = params.tag;
    
    function filterPosts() {
        const query = searchInput.value.toLowerCase();
        const tag = tagFilter.value;
        
        postCards.forEach(card => {
            const title = card.dataset.postTitle;
            const summary = card.dataset.postSummary || '';
            const postTags = card.dataset.postTags;
            
            const searchable = title + ' ' + summary;
            const matchesQuery = !query || searchable.includes(query);
            const matchesTag = !tag || postTags.includes(tag);
            
            card.style.display = matchesQuery && matchesTag ? '' : 'none';
        });
    }
    
    filterPosts();
    
    searchInput.addEventListener('input', filterPosts);
    
    tagFilter.addEventListener('change', function() {
        if (this.value) {
            window.location.href = '/tutoriais/?tag=' + encodeURIComponent(this.value);
        } else {
            window.location.href = '/tutoriais/';
        }
    });
});
</script>
