<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or site.tagline }}">
    <meta name="author" content="{{ site.author }}">
    <meta name="robots" content="{{ robots or 'index, follow' }}">
    
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#212529">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="{{ site.title }}">
    <link rel="apple-touch-icon" href="/images/icon-192.png">

    <link href="/_pagefind/pagefind-ui.css" rel="stylesheet">
    
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ description or site.tagline }}">
    <meta property="og:image" content="{% if post and post.coverImage %}{{ post.coverImage }}{% else %}{{ site.url }}{{ site.ogImage }}{% endif %}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:locale" content="pt_BR">
    
    {% if post %}
    <meta property="article:published_time" content="{{ post.datePublished }}">
    <meta property="article:author" content="{{ site.author }}">
    <meta property="article:section" content="{{ post.category }}">
    {% for tag in post.tags %}<meta property="article:tag" content="{{ tag }}">{% endfor %}
    {% endif %}
    
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.title }}">
    <meta name="twitter:description" content="{{ description or site.tagline }}">
    <meta name="twitter:image" content="{% if post and post.coverImage %}{{ post.coverImage }}{% else %}{{ site.url }}{{ site.ogImage }}{% endif %}">
    
    {% if post %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": "{{ post.title }}",
        "datePublished": "{{ post.datePublished }}",
        "dateModified": "{{ post.dateModified }}",
        "author": {
            "@type": "Person",
            "name": "{{ post.author }}"
        },
        "publisher": {
            "@type": "Organization",
            "name": "{{ site.title }}",
            "logo": {
                "@type": "ImageObject",
                "url": "{{ site.url }}{{ site.ogImage }}"
            }
        },
        "url": "{{ site.url }}{{ page.url }}",
        "image": {
            "@type": "ImageObject",
            "url": "{% if post.coverImage %}{{ post.coverImage }}{% else %}{{ site.url }}{{ site.ogImage }}{% endif %}",
            "width": "1200",
            "height": "630"
        },
        "description": "{{ post.description or (post.summary | striptags) }}",
        "articleSection": "{{ post.category }}",
        "keywords": "{{ post.tags | join(', ') }}"
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Início", "item": "{{ site.url }}/" },
            { "@type": "ListItem", "position": 2, "name": "{{ post.category }}", "item": "{{ site.url }}/categoria/{{ post.category | slugify }}/" },
            { "@type": "ListItem", "position": 3, "name": "{{ post.title }}", "item": "{{ site.url }}{{ page.url }}" }
        ]
    }
    </script>
    {% endif %}
    
    {% if not post %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ site.title }}",
        "url": "{{ site.url }}",
        "description": "{{ site.tagline }}",
        "potentialAction": {
            "@type": "SearchAction",
            "target": "{{ site.url }}/?q={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>
    {% endif %}
    
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/rss.xml">
    
    <link rel="shortcut icon" href="/favicon.ico">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" rel="stylesheet">
    
    <link href="/css/style.css?v={{ site.cacheVersion }}" rel="stylesheet">
</head>
<body>
    <a href="#main-content" class="skip-link visually-hidden-focusable">Pular para o conteúdo principal</a>
    
    <div id="cookieConsent" class="cookie-consent" role="alert" aria-live="polite">
        <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2">
            <p class="mb-0 small">
                <i class="bi bi-shield-check text-primary me-1"></i>
                Este site utiliza cookies para analytics e anúncios. Ao continuar, você aceita o uso de cookies.
            </p>
            <div class="d-flex gap-2">
                <button id="acceptCookies" class="btn btn-primary btn-sm">Aceitar</button>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg bg-body-tertiary sticky-top" aria-label="Menu principal">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="bi bi-bug-fill text-primary me-2 fs-4"></i>
                <span class="fw-bold">QA Overflow</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link{% if page.url == '/' %} active{% endif %}" href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>
                            <i class="bi bi-house me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{% if page.url == '/sobre/' %} active{% endif %}" href="/sobre/"{% if page.url == '/sobre/' %} aria-current="page"{% endif %}>
                            <i class="bi bi-info-circle me-1"></i> Sobre
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{% if page.url == '/tutoriais/' %} active{% endif %}" href="/tutoriais/"{% if page.url == '/tutoriais/' %} aria-current="page"{% endif %}>
                            <i class="bi bi-book me-1"></i> Tutoriais
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{% if page.url == '/ferramentas/' %} active{% endif %}" href="/ferramentas/"{% if page.url == '/ferramentas/' %} aria-current="page"{% endif %}>
                            <i class="bi bi-tools me-1"></i> Utilidades
                        </a>
                    </li>
                </ul>
                <button class="btn btn-outline-secondary btn-sm me-2" type="button" id="themeToggle" aria-label="Alternar tema">
                    <i class="bi bi-moon-stars" id="themeIcon"></i>
                </button>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#searchModal" aria-label="Buscar">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
    </nav>

    <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-body-tertiary">
                <div class="modal-header border-0">
                    <h5 class="modal-title">
                        <i class="bi bi-search text-primary me-2"></i>Buscar
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="search"></div>
                </div>
            </div>
        </div>
    </div>

    <main id="main-content" class="py-5">
        <div class="container">
            {{ content | safe }}
        </div>
    </main>

    <footer class="bg-body-tertiary py-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-bug-fill text-primary me-2"></i>QA Overflow
                    </h5>
                    <p class="text-muted">{{ site.tagline }}</p>
                </div>

                <div class="col-md-3">
                    <h6 class="fw-semibold mb-3">Newsletter</h6>
                    <p class="text-muted small">Receba os posts por e-mail</p>
                    <a href="https://qaoverflow.substack.com/" class="btn btn-outline-primary btn-sm" target="_blank">
                        <i class="bi bi-envelope me-1"></i>Inscreva-se
                    </a>
                </div>

                <div class="col-md-3">
                    <h6 class="fw-semibold mb-3">Redes</h6>
                    <ul class="list-unstyled">
                        <li>
                            <a href="https://github.com/VictorHOliveira" class="text-decoration-none">
                                <i class="bi bi-github me-2"></i>GitHub
                            </a>
                        </li>
                        <li>
                            <a href="https://www.linkedin.com/in/victor-hugo-de-oliveira/" class="text-decoration-none" target="_blank">
                                <i class="bi bi-linkedin me-2"></i>LinkedIn
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="row">
                <div class="col-md-6 text-muted small">
                    &copy; {{ currentYear }} {{ site.author }}. Todos os direitos reservados.
                </div>
                <div class="col-md-6 text-md-end text-muted small">
                    Feito com <i class="bi bi-heart-fill text-danger"></i> usando 11ty e Bootstrap 5
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>if(document.querySelector('pre code')){hljs.highlightAll();}</script>
    
    <script src="/_pagefind/pagefind-ui.js" onload="new PagefindUI({ element: '#search', showSubResults: true, showImages: false });"></script>

    <script>
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(function(err) {
            console.warn('Service worker registration failed:', err);
        });
    }
    </script>
    
    <script>
    (function(){
        var COOKIE_KEY = 'qaoverflow_cookies_accepted';
        var accepted = localStorage.getItem(COOKIE_KEY);

        function loadScript(src, attrs) {
            var s = document.createElement('script');
            s.src = src;
            s.async = true;
            if (attrs) {
                Object.keys(attrs).forEach(function(k) { s.setAttribute(k, attrs[k]); });
            }
            document.head.appendChild(s);
        }

        function loadTracking() {
            loadScript('https://www.googletagmanager.com/gtag/js?id={{ site.analytics }}');
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '{{ site.analytics }}');
            loadScript('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8346007198132292', { 'crossorigin': 'anonymous' });
        }

        if (accepted === 'true') {
            loadTracking();
        } else {
            var banner = document.getElementById('cookieConsent');
            if (banner) {
                banner.classList.add('show');
                document.getElementById('acceptCookies').addEventListener('click', function() {
                    localStorage.setItem(COOKIE_KEY, 'true');
                    banner.classList.remove('show');
                    loadTracking();
                });
            }
        }
    })();
    </script>

    <button id="backToTop" class="back-to-top" aria-label="Voltar ao topo">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script>
    (function(){
        var btn = document.getElementById('backToTop');
        if (btn) {
            window.addEventListener('scroll', function() {
                btn.classList.toggle('visible', window.scrollY > 400);
            });
            btn.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }
    })();
    </script>

    <script>
    (function(){
        var toggle = document.getElementById('themeToggle');
        var icon = document.getElementById('themeIcon');
        var html = document.documentElement;
        var key = 'qaoverflow_theme';

        function setTheme(theme) {
            html.setAttribute('data-bs-theme', theme);
            if (icon) {
                icon.className = theme === 'dark' ? 'bi bi-moon-stars' : 'bi bi-sun';
            }
            localStorage.setItem(key, theme);
        }

        var saved = localStorage.getItem(key);
        if (saved === 'light' || saved === 'dark') {
            setTheme(saved);
        }

        if (toggle) {
            toggle.addEventListener('click', function() {
                var current = html.getAttribute('data-bs-theme');
                setTheme(current === 'dark' ? 'light' : 'dark');
            });
        }
    })();
    </script>

    {% if customJs %}
    <script src="{{ customJs }}"></script>
    {% endif %}
</body>
</html>
