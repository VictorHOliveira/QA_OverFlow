---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <changefreq>daily</changefreq>
    <priority>1.00</priority>
  </url>
  <url>
    <loc>{{ site.url }}/sobre/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.50</priority>
  </url>
  <url>
    <loc>{{ site.url }}/tutoriais/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.60</priority>
  </url>
  <url>
    <loc>{{ site.url }}/ferramentas/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.50</priority>
  </url>
{%- for post in posts | published %}
  <url>
    <loc>{{ site.url }}/post/{{ post.slug }}/</loc>
    <lastmod>{{ post.dateModified or post.datePublished }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.80</priority>
  </url>
{%- endfor %}
{%- for tag in collections.allTags %}
  <url>
    <loc>{{ site.url }}/tag/{{ tag | slugify }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.50</priority>
  </url>
{%- endfor %}
{%- for cat in collections.allCategories %}
  <url>
    <loc>{{ site.url }}/categoria/{{ cat | slugify }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.60</priority>
  </url>
{%- endfor %}
</urlset>
